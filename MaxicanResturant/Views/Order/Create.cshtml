@model OrderViewModel

@{
    ViewBag.Title = "Create Order";
}

<h1>Create Order</h1>

<div class="row">
    @foreach (Product product in @Model.Products) // The @Model.Products is a collection of Product objects that is part of the OrderViewModel. By iterating over this collection using a foreach loop, we can display each product's details (such as name, price, and image) in the view. This allows users to see the available products and add them to their order by submitting the form for each product. @foreach (Product product in @Model.Products) iterates through each Product object in the Products collection of the OrderViewModel, allowing us to display the details of each product and provide a form for adding it to the order.
    {
        <div class="col-md-4">
            <form asp-action="AddItem" method="post">
                <div class="card" style="width: 18rem;">
                    <img src="@Url.Content("~/images/" + product?.ImageUrl)" class="card-img-top fixed-image-height" alt="@product.Description">
                    <div class="card-body">
                        @product.Name - @product.Price.ToString("C")
                        <input type="hidden" value="@product.ProductId" name="prodId" />
                        <input type="number" name="prodQty" class="form-control" />
                        <button class="btn btn-info" type="submit">Add</button>
                    </div>
                </div>
            </form>
        </div>
    }
</div>
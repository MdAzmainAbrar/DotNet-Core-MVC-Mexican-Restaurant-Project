@model IEnumerable<Product> //why? Because the Index view is designed to display a list of products, it needs to receive an IEnumerable<Product> as its model. This allows the view to iterate over the collection of products and display each product's details (such as name, description, price, etc.) in a structured format, such as a table or a grid. By using IEnumerable<Product>, the view can handle any number of products, from zero to many, and render them accordingly.       

@{
    ViewBag.Title = "Tequilas Menu Items ";
}

@functions { //the use of @functions in a Razor view allows you to define helper methods that can be used within the view to perform specific tasks or calculations. In this case, the GetDeleteModalId and GetModalId methods are defined to generate unique IDs for the delete confirmation modals based on the product's ID. This helps ensure that each modal has a unique identifier, which is important for correctly targeting the modals when they are triggered by the delete buttons. By using these helper methods, you can keep your Razor view clean and organized while still providing the necessary functionality for handling delete actions.
    string GetDeleteModalId(Product prod)
    {
        return "#deleteModal" + prod.ProductId; // This method generates a unique ID for the delete confirmation modal by concatenating the string "deleteModal" with the product's ID. The resulting string is prefixed with a "#" to indicate that it is an ID selector, which can be used in the data-bs-target attribute of the delete button to trigger the corresponding modal when clicked.
    }

    string GetModalId(Product prod)
    {
        return "deleteModal" + prod.ProductId; // This method generates a unique ID for the delete confirmation modal by concatenating the string "deleteModal" with the product's ID. This ID is used in the modal's HTML element to uniquely identify it.
    }

}

<h2>Tequilas Menu Items</h2>
<a asp-action="AddEdit" asp-controller="Product" class="btn btn-primary">Create New Item</a> @* here we used an ASP.NET Core tag helper on an anchor tag to generate a link. The asp-controller and asp-action attributes direct the user to the AddEdit action method within the Product controller, while the class attribute applies Bootstrap button styling to make it clearly visible as the primary action for adding a new item. *@

<div class="row">
    @foreach (Product prod in Model)
    {
        <div class="col-md-4">
            <form asp-action="delete" asp-controller="product" method="post">
                <input type="hidden" name="id" value="@prod.ProductId" />
                <div class="card" style="width: 18rem;">
                    <img src="@Url.Content("~/images/" + prod?.ImageUrl)" class="card-img-top fixed-image-height" alt="@prod.Description">
                    <div class="card-body">
                        <h5 class="card-title">@prod.Name</h5>
                        <p class="card-text">@prod.Description</p>
                        <p class="card-text">@prod.Price.ToString("C")</p>
                        <p class="card-text">Quantity In Stock: @prod.Stock</p>
                        <a class="btn btn-info" asp-controller="Product" asp-action="AddEdit" asp-route-id="@prod.ProductId"><i class="bi bi-pencil-fill">Edit</i></a>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="@GetDeleteModalId(prod)">
                            <i class="bi bi-trash">Delete</i>
                        </button>
                        <div class="modal fade" id="@GetModalId(prod)" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Are you sure you want to delete @prod.Name?</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                   
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    }
</div>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager // Inject the SignInManager to check if the user is signed in and to manage user authentication. 
@inject UserManager<ApplicationUser> UserManager // Inject the UserManager to manage user-related operations, such as retrieving user information. the difference between SignInManager and UserManager is that SignInManager is responsible for handling user sign-in and authentication processes, while UserManager is responsible for managing user-related operations, such as creating users, retrieving user information, and managing user roles and claims.

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User)) // @if (SignInManager.IsSignedIn(User)) checks if the current user is authenticated (i.e., signed in). If the user is signed in, the code inside the if block will be executed, which typically includes displaying user-specific information or options, such as a greeting with the user's name and a logout button. If the user is not signed in, the else block will be executed, which usually includes options for registering or logging in.
    {
        <li class="nav-item">
            <!--Determine number of cart items saved in session-->
            @{
                int cartCount = 0;
                if (Context.Session.Get<OrderViewModel>("OrderViewModel") != null)
                {
                    OrderViewModel model = Context.Session.Get<OrderViewModel>("OrderViewModel");
                    cartCount = model.OrderItems.Sum(product => product.Quantity);
                }
            }
            <a class="nav-link position-relative" asp-action="Cart" asp-controller="Order">
                <i class="bi bi-cart2"></i>
                <span class="position-absolute start-100 translate-middle badge rounded-pill bg-success">
                    @cartCount
                    <span class="visually-hidden">Cart Quantity</span>
                </span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>